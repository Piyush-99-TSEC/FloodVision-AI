# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/flood_vision_AI?retryWrites=true&w=majority

# Security
JWT_SECRET=your_jwt_secret_key_here

# AI Service Microservice (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000/api/v1/analyze

# Runtime Mode
NODE_ENV=development
